# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Model ID available on your API project, e.g. gpt-6-sol
OPENAI_MODEL=gpt-6-sol

# Optional: NVIDIA Build (build.nvidia.com), key starts with nvapi-
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# Optional: OpenRouter (openrouter.ai), key starts with sk-or-
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
